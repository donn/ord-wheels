--- /dev/null
+++ b/python/openroad/openroad_test.py
@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# Copyright (c) 2026, The OpenROAD Authors
+
+"""Python binding unit tests for the openroad package: one behavior per
+test, each on its own Tech."""
+
+import unittest
+
+import odb
+from openroad import Design, Tech, set_thread_count, thread_count
+
+
+class OpenRoadApiTest(unittest.TestCase):
+    def test_thread_count(self):
+        # The thread count belongs to the Tech's OpenRoad instance, which
+        # must stay alive while it is used.
+        tech = Tech()
+        set_thread_count(2)
+        self.assertEqual(thread_count(), 2)
+        set_thread_count(1)
+        self.assertEqual(thread_count(), 1)
+
+    def test_tech_has_database(self):
+        tech = Tech()
+        self.assertIsInstance(tech.getDB(), odb.dbDatabase)
+
+    def test_design_without_block(self):
+        tech = Tech()
+        design = Design(tech)
+        self.assertIsNone(design.getBlock())
+
+    def test_several_techs_in_one_process(self):
+        techs = [Tech() for _ in range(3)]
+        # Compare the underlying C++ pointers, not the proxy objects.
+        self.assertEqual(len({int(tech.getDB().this) for tech in techs}), 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/python/openroad/wheel_test.py b/python/openroad/wheel_test.py
new file mode 100644
index 0000000000..ece5047951
--- /dev/null
+++ b/python/openroad/wheel_test.py
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# Copyright (c) 2026, The OpenROAD Authors
+
+"""Installs the openroad wheel into an empty directory and imports it in a
+fresh interpreter, as a user who ran `pip install` would."""
+
+import glob
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+import zipfile
+
+# Run in a child interpreter with -I, so neither PYTHONPATH nor this test's
+# runfiles can supply a module the wheel is missing.
+IMPORT_CHECK = """
+import sys
+sys.path.insert(0, sys.argv[1])
+import openroad
+import odb, utl, gpl, ant, cts, drt, grt, ifp, pdn, rcx, stt, tap
+from openroad import Design, Tech
+tech = Tech()
+assert odb.dbDatabase is not None
+assert hasattr(ant, "AntennaChecker")
+assert isinstance(utl.ANT, int)
+print("imported", openroad.__file__)
+"""
+
+
+class WheelTest(unittest.TestCase):
+    def test_install_and_import(self):
+        wheels = glob.glob(os.path.join(os.path.dirname(__file__), "*.whl"))
+        self.assertEqual(len(wheels), 1, wheels)
+        with tempfile.TemporaryDirectory() as site:
+            # A wheel's payload is its install layout.
+            with zipfile.ZipFile(wheels[0]) as wheel:
+                wheel.extractall(site)
+            result = subprocess.run(
+                [sys.executable, "-I", "-c", IMPORT_CHECK, site],
+                capture_output=True,
+                text=True,
+                check=False,
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertIn(os.path.join(site, "openroad"), result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
