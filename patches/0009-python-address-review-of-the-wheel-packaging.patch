-"""Installs the openroad wheel into an empty directory and imports it in a
-fresh interpreter, as a user who ran `pip install` would."""
+"""Installs the openroad wheel with pip into an empty directory and imports
+it in a fresh interpreter."""
 
 import glob
 import os
@@ -10,7 +10,6 @@ import subprocess
 import sys
 import tempfile
 import unittest
-import zipfile
 
 # Run in a child interpreter with -I, so neither PYTHONPATH nor this test's
 # runfiles can supply a module the wheel is missing.
@@ -37,9 +36,21 @@ class WheelTest(unittest.TestCase):
         wheels = glob.glob(os.path.join(os.path.dirname(__file__), "*.whl"))
         self.assertEqual(len(wheels), 1, wheels)
         with tempfile.TemporaryDirectory() as site:
-            # A wheel's payload is its install layout.
-            with zipfile.ZipFile(wheels[0]) as wheel:
-                wheel.extractall(site)
+            subprocess.run(
+                [
+                    sys.executable,
+                    "-m",
+                    "pip",
+                    "install",
+                    "--quiet",
+                    "--no-index",
+                    "--no-deps",
+                    "--target",
+                    site,
+                    wheels[0],
+                ],
+                check=True,
+            )
             result = subprocess.run(
                 [sys.executable, "-I", "-c", IMPORT_CHECK, site],
                 capture_output=True,
diff --git a/src/OpenRoad-py.i b/src/OpenRoad-py.i
index b25dc92377..39ffbe6439 100644
--- a/src/OpenRoad-py.i
+++ b/src/OpenRoad-py.i
@@ -120,10 +120,12 @@ namespace ord {
 
 %}
 
+#ifdef BAZEL
 // odb, utl and rmp are separate extension modules that other extensions
 // import, so they cannot be compiled in here.  Re-export them so
 // `from openroadpy import *` is the whole API.  Each module defines its own
-// SwigPyIterator; keep this one.
+// SwigPyIterator; keep this one.  (CMake registers odb, utl and rmp as
+// their own top-level modules instead.)
 %pythoncode %{
 _openroadpy_iterator = SwigPyIterator
 from src.odb.odb import *
@@ -132,3 +134,4 @@ from src.rmp.rmp_py import *
 SwigPyIterator = _openroadpy_iterator
 del _openroadpy_iterator
 %}
+#endif
diff --git a/src/OpenRoad.i b/src/OpenRoad.i
index ae3b02dda2..c35b4719f2 100644
--- a/src/OpenRoad.i
+++ b/src/OpenRoad.i
@@ -39,7 +39,15 @@ using odb::dbDatabase;
 OpenRoad *
 getOpenRoad()
 {
-  return OpenRoad::openRoad();
+  // From Python the current instance is the one set by the most recently
+  // created Tech, and destroying that Tech clears it even if older ones
+  // are still alive.
+  OpenRoad *openroad = OpenRoad::openRoad();
+  if (openroad == nullptr) {
+    utl::Logger::defaultLogger()->error(
+        utl::ORD, 105, "No current OpenROAD instance; create a Tech and keep it alive.");
+  }
+  return openroad;
 }
 
 utl::Logger *
