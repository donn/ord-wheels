From 46627e07ab6f8573c43a54feca8686113a47b8fe Mon Sep 17 00:00:00 2001
From: Matt Liberty <mliberty@precisioninno.com>
Date: Sun, 11 Oct 2026 15:45:45 +0000
Subject: [PATCH 06/13] python: provide every bound tool module in
 python/modules

Add cgt, dpl, exa, fin, par, ppl, psm, rsz and wmk, matching the modules
`openroad -python` registers, so the wheel and tests can import them.
wmk_py no longer puts src/wmk on sys.path, as for odb. syn, ram and web
have no Python extension in the Bazel build and are left out.

Signed-off-by: Matt Liberty <mliberty@precisioninno.com>
---
 python/modules/BUILD          | 3 ++-
 python/modules/cgt.py         | 5 +++++
 python/modules/dpl.py         | 5 +++++
 python/modules/exa.py         | 5 +++++
 python/modules/fin.py         | 5 +++++
 python/modules/par.py         | 5 +++++
 python/modules/ppl.py         | 5 +++++
 python/modules/psm.py         | 5 +++++
 python/modules/rsz.py         | 5 +++++
 python/modules/wmk.py         | 4 ++++
 python/openroad/wheel_test.py | 4 +++-
 src/wmk/BUILD                 | 4 +++-
 12 files changed, 52 insertions(+), 3 deletions(-)
 create mode 100644 python/modules/cgt.py
 create mode 100644 python/modules/dpl.py
 create mode 100644 python/modules/exa.py
 create mode 100644 python/modules/fin.py
 create mode 100644 python/modules/par.py
 create mode 100644 python/modules/ppl.py
 create mode 100644 python/modules/psm.py
 create mode 100644 python/modules/rsz.py
 create mode 100644 python/modules/wmk.py

diff --git a/python/modules/BUILD b/python/modules/BUILD
index 69e13aea2c..9215c5b5a5 100644
--- a/python/modules/BUILD
+++ b/python/modules/BUILD
@@ -6,7 +6,8 @@ load("@rules_python//python:defs.bzl", "py_library")
 package(features = ["layering_check"])
 
 # Top-level per-tool modules (import odb, import ant, ...), matching the
-# modules `openroad -python` provides. They re-export the extension
+# modules `openroad -python` provides, except syn, ram and web, which have
+# no Python extension in the Bazel build. They re-export the extension
 # modules, so //python/openroad:openroadpy depends on this target and the
 # wheel installs these files at the top level.
 py_library(
